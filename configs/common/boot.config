# Everything the kernel needs to reach its disk and mount the root filesystem.
# These are built in (=y), not modules, so a kernel can still boot if its
# initramfs is missing a module.

# initramfs support (Arch's mkinitcpio uses zstd by default)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_RD_GZIP=y

# Loadable modules (most hardware drivers are modules)
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# /dev, /tmp and friends
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# Disk access (SATA in AHCI mode) and partition handling
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# Filesystems: ext4 root, the EFI system partition, and NTFS for Windows partitions
CONFIG_EXT4_FS=y
CONFIG_NTFS3_FS=m
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# UEFI boot
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Built-in laptop keyboard, and USB so a rescue keyboard always works
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
