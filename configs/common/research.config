# Signals and instrumentation for the REM and ICS scheduler work.

# Pressure Stall Information: how long tasks wait for CPU, memory and I/O.
# This is the closest existing kernel signal to what REM and ICS want to measure.
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set

# Per-task accounting (ICS can start from task_io_accounting)
CONFIG_TASKSTATS=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y

# Scheduler debug interfaces under /sys/kernel/debug/sched. In current kernels
# these come with DEBUG_FS; there is no separate SCHED_DEBUG option any more.
CONFIG_DEBUG_FS=y
