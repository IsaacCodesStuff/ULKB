# Keeps a build small and independent of whatever tuning the base config carries.
# Useful on a CI runner (limited RAM and disk) and for comparisons where every
# build should be compiled the same way.

# No link-time optimisation: ThinLTO needs a lot of RAM and time to link.
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG_THIN is not set
# CONFIG_LTO_CLANG_FULL is not set

# No debug info: it multiplies build time and disk use. Turn it back on
# when you need to debug with symbols.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_BTF is not set
