# ThinkPad T440 (Haswell-ULT) hardware support.
#
# Built from `lspci -k`, `lsusb` and `lsmod` taken on the machine itself.
# Boot-critical pieces (disk, filesystems, USB host) live in
# configs/common/boot.config; this file is for everything else, mostly as
# modules (=m) the way a distro kernel does it.
#
# Not included on purpose: the BIOS-flash chip (spi_intel, spi_nor, at24) and
# the Management Engine extras (mei_hdcp, mei_pxp). Nothing needs them to run.

# ── CPU, power and thermal ───────────────────────────────────────────────────
CONFIG_MICROCODE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_INTEL_IDLE=y
CONFIG_X86_PKG_TEMP_THERMAL=m
CONFIG_INTEL_POWERCLAMP=m
CONFIG_SENSORS_CORETEMP=m
CONFIG_POWERCAP=y
CONFIG_INTEL_RAPL=m
CONFIG_PERF_EVENTS_INTEL_RAPL=m
CONFIG_PERF_EVENTS_INTEL_CSTATE=m
CONFIG_PERF_EVENTS_INTEL_UNCORE=m

# Virtualisation (kvm_intel is loaded on the T440)
CONFIG_KVM=m
CONFIG_KVM_INTEL=m

# ── ThinkPad platform ────────────────────────────────────────────────────────
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_VIDEO=m
CONFIG_ACPI_WMI=m
CONFIG_THINKPAD_ACPI=m
CONFIG_THINKPAD_LMI=m
CONFIG_RFKILL=m
CONFIG_LPC_ICH=m
CONFIG_I2C_I801=m
CONFIG_I2C_CHARDEV=m
CONFIG_INTEL_MEI=m
CONFIG_INTEL_MEI_ME=m

# ── Touchpad and TrackPoint (Synaptics, talks RMI over SMBus) ───────────────
CONFIG_MOUSE_PS2=m
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_SYNAPTICS_SMBUS=y
CONFIG_MOUSE_PS2_TRACKPOINT=y
CONFIG_RMI4_CORE=m
CONFIG_RMI4_SMB=m
CONFIG_RMI4_F03=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
CONFIG_RMI4_F30=y
CONFIG_RMI4_F3A=y

# ── Graphics (Intel Haswell, i915) ───────────────────────────────────────────
CONFIG_DRM=y
CONFIG_DRM_I915=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ── Audio (Intel HD Audio, Realtek codec, HDMI) ──────────────────────────────
CONFIG_SOUND=y
CONFIG_SND=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_ALC269=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_HDMI_INTEL=m
CONFIG_SND_SEQUENCER=m
CONFIG_SND_SEQ_DUMMY=m
CONFIG_SND_HRTIMER=m

# ── Networking: Intel I218-LM ethernet, Intel 7260 Wi-Fi, Bluetooth ─────────
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000E=m

CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m

CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HCIBTUSB=m

# The algif_* modules on the T440 suggest a Wi-Fi daemon using the kernel
# crypto API (iwd). These are inferred, so check the config audit if Wi-Fi
# authentication fails.
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
CONFIG_CRYPTO_CCM=m
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=m
CONFIG_CRYPTO_AES_NI_INTEL=m

# ── Webcam, card reader, serial devices ──────────────────────────────────────
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m

CONFIG_MISC_RTSX_PCI=m
CONFIG_MMC=m
CONFIG_MMC_BLOCK=m
CONFIG_MMC_REALTEK_PCI=m

CONFIG_USB_ACM=m

# ── I/O scheduler: the T440 has a spinning HDD, so BFQ and mq-deadline matter
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_IOSCHED_BFQ=y

# ── Compressed RAM swap (zram is loaded on the T440) ─────────────────────────
CONFIG_ZRAM=m
CONFIG_CRYPTO_LZ4=m
CONFIG_CRYPTO_LZ4HC=m
CONFIG_CRYPTO_ZSTD=m
