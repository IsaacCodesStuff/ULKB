# Common ThinkPad hardware support
CONFIG_THINKPAD_ACPI=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_THERMAL=y
CONFIG_THERMAL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_IWLWIFI=y              # Intel WiFi (most ThinkPads)
CONFIG_NVME_CORE=y
CONFIG_BLQ_MQ=y
CONFIG_DRM_I915=y             # Intel graphics (T480)
CONFIG_SOUND=y
CONFIG_SND_HDA_INTEL=y